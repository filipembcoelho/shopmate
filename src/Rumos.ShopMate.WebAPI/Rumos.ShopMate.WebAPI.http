@host = https://localhost:7027
@token = PASTE_ACCESS_TOKEN_HERE
@listId = 1
@itemId = 1
@memberUserId = 2

### Login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "student",
  "password": "Classroom1!"
}

### Register
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Angular Student",
  "username": "angularstudent",
  "password": "Classroom1!"
}

### Suggest username
GET {{host}}/api/users/suggest-username?fullName=Angular%20Student
Authorization: Bearer {{token}}

### Find user
GET {{host}}/api/users/angularstudent
Authorization: Bearer {{token}}

### Search products
GET {{host}}/api/products?searchText=milk
Authorization: Bearer {{token}}

### Current authenticated user
GET {{host}}/api/auth/me
Authorization: Bearer {{token}}

### Admin-only check (a User token receives 403)
GET {{host}}/api/auth/admin-check
Authorization: Bearer {{token}}

### Get active shopping lists
GET {{host}}/api/shopping-lists
Authorization: Bearer {{token}}

### Get one shopping list
GET {{host}}/api/shopping-lists/{{listId}}
Authorization: Bearer {{token}}

### Create shopping list
POST {{host}}/api/shopping-lists
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Angular course groceries"
}

### Rename shopping list
PUT {{host}}/api/shopping-lists/{{listId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Updated Angular groceries"
}

### Add item
POST {{host}}/api/shopping-lists/{{listId}}/items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Milk",
  "quantity": 2,
  "unit": 4
}

### Replace item state
PUT {{host}}/api/shopping-lists/{{listId}}/items/{{itemId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Oat milk",
  "quantity": 3,
  "unit": 10,
  "isCompleted": true
}

### Remove item
DELETE {{host}}/api/shopping-lists/{{listId}}/items/{{itemId}}
Authorization: Bearer {{token}}

### Share shopping list
POST {{host}}/api/shopping-lists/{{listId}}/members
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "angularstudent",
  "role": 2
}

### Change member role
PUT {{host}}/api/shopping-lists/{{listId}}/members/{{memberUserId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role": 3
}

### Remove member
DELETE {{host}}/api/shopping-lists/{{listId}}/members/{{memberUserId}}
Authorization: Bearer {{token}}

### Archive shopping list
DELETE {{host}}/api/shopping-lists/{{listId}}
Authorization: Bearer {{token}}
